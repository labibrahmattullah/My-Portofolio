TELEGRAM_PY = r"""#!/usr/bin/env python3
# custom-telegram: Wazuh integration that sends alert summaries to a Telegram chat.
#
# Sanitized reference based on the logic documented in Figure 8 of the report
# (field extraction, HTML message format, sendMessage call). Credentials are read
