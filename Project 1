def main() -> None:
    ap = argparse.ArgumentParser(description="Build and publish the SOC lab documentation repository to GitHub.")
    ap.add_argument("--docx", required=True, type=Path, help="Path to the .docx report")
    ap.add_argument("--out", type=Path, default=Path("./" + REPO_NAME_DEFAULT), help="Local repository output directory")
    ap.add_argument("--repo", default=REPO_NAME_DEFAULT, help="GitHub repository name")
    ap.add_argument("--branch", default="main")
    ap.add_argument("--private", action="store_true", help="Create a private repository (recommended for initial review)")
    ap.add_argument("--dry-run", action="store_true", help="Only build + scan, without commit/push")
    ap.add_argument("--no-push", action="store_true", help="Build + local commit, without push")
    ap.add_argument("--no-report-copy", action="store_true", help="Do not include the .docx file in the repository")
    ap.add_argument("--git-name", help="Override git user.name for the commit")
    ap.add_argument("--git-email", help="Override git user.email for the commit")
    ap.add_argument("--force", action="store_true", help="Use --force-with-lease when pushing")
    ap.add_argument("-y", "--yes", action="store_true", help="Skip interactive confirmation")
    args = ap.parse_args()

    if not args.docx.is_file():
        die(f"File not found: {args.docx}")
    if shutil.which("git") is None:
        die("git was not found in PATH.")

    token = os.environ.get("GITHUB_TOKEN", "").strip()
    publishing = not (args.dry_run or args.no_push)
    if publishing and not token:
        die("GITHUB_TOKEN is not set. Contoh: export GITHUB_TOKEN=... (atau gunakan --dry-run).")

    build_repo(args.out, args.docx, include_report=not args.no_report_copy)
    secret_scan(args.out)

    if args.dry_run:
        info(f"Dry run selesai. Review isi: {args.out.resolve()}")
        return

    login = None
    if token:
        status, user = gh_api("GET", "/user", token)
        if status != 200:
            die(f"Token tidak valid ({status}): {user.get('message')}")
        login = user["login"]
        info(f"Authenticated as: {login}")

    git_commit(args.out, args.branch, args.git_name, args.git_email, login)

    if args.no_push:
        info("Local commit completed (--no-push).")
        return

    visibility = "PRIVATE" if args.private else "PUBLIC"
    if not args.yes:
        ans = input(f"Publish {login}/{args.repo} sebagai {visibility}? Have the screenshots been reviewed? [y/N] ")
        if ans.strip().lower() not in {"y", "yes"}:
            die("Cancelled by user.", 0)

    status, resp = gh_api(
        "POST", "/user/repos", token,
        {
            "name": args.repo,
            "description": REPO_DESCRIPTION,
            "private": bool(args.private),
            "has_issues": True,
            "has_wiki": False,
            "auto_init": False,
        },
    )
    if status == 201:
        info(f"Repository created: {resp['html_url']}")
    elif status == 422 and "already exists" in json.dumps(resp):
        info("Repository already exists; using the existing repository.")
    else:
        die(f"Failed to create repository ({status}): {resp.get('message')} {resp.get('errors', '')}")

    git_push(args.out, login, args.repo, args.branch, token, args.force)

    s, r = gh_api("PUT", f"/repos/{login}/{args.repo}/topics", token, {"names": TOPICS})
    if s not in (200, 201):
        print(f"[!] Topics could not be applied ({s}): {r.get('message')}", file=sys.stderr)

    print(f"\n[+] Completed: https://github.com/{login}/{args.repo}")


