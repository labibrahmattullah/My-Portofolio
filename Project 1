def gh_api(method: str, path: str, token: str, payload=None):
    req = urllib.request.Request(
        f"https://api.github.com{path}",
        method=method,
        data=json.dumps(payload).encode() if payload is not None else None,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "soc-lab-publisher",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            body = r.read().decode() or "{}"
            return r.status, json.loads(body)
    except urllib.error.HTTPError as e:
        body = e.read().decode() or "{}"
        try:
            return e.code, json.loads(body)
        except json.JSONDecodeError:
            return e.code, {"message": body}


def git_commit(out: Path, branch: str, name: str | None, email: str | None, login: str | None) -> None:
    if not (out / ".git").exists():
        run(["git", "init"], out)
    run(["git", "symbolic-ref", "HEAD", f"refs/heads/{branch}"], out)

    cfg_name = run(["git", "config", "user.name"], out, check=False).stdout.strip()
    cfg_email = run(["git", "config", "user.email"], out, check=False).stdout.strip()
    name = name or cfg_name or AUTHOR
    email = email or cfg_email or f"{login or GITHUB_USER_DEFAULT}@users.noreply.github.com"
    ident = ["-c", f"user.name={name}", "-c", f"user.email={email}"]

    run(["git", "add", "-A"], out)
    status = run(["git", "status", "--porcelain"], out).stdout.strip()
    if not status:
        info("Tidak ada perubahan untuk di-commit.")
        return
    run(["git"] + ident + ["commit", "-m", COMMIT_MESSAGE], out)
    info(f"Commit created as {name} <{email}>")


def git_push(out: Path, owner: str, repo: str, branch: str, token: str, force: bool) -> None:
    remote = f"https://github.com/{owner}/{repo}.git"
    has = run(["git", "remote"], out).stdout.split()
    if "origin" in has:
        run(["git", "remote", "set-url", "origin", remote], out)
    else:
        run(["git", "remote", "add", "origin", remote], out)

    basic = base64.b64encode(f"x-access-token:{token}".encode()).decode()
    cmd = [
        "git", "-c", f"http.https://github.com/.extraheader=AUTHORIZATION: basic {basic}",
        "push", "-u", "origin", branch,
    ]
    if force:
        cmd.insert(-3, "--force-with-lease")
    res = run(cmd, out, check=False)
    if res.returncode != 0:
        err = res.stderr.replace(basic, "***")
        die(
            "Push failed:\n" + err +
            "\nIf the remote repository already contains other commits, review it first and use --force "
            "hanya if you are certain."
        )
    info("Push succeeded.")


