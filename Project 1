# Wazuh invokes integrations as:  custom-telegram <alert_file> <api_key> <hook_url>
# Required environment (e.g. set in the service environment of wazuh-manager):
#   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
#
# Verify against the deployed script before relying on this copy.

import html
import json
import os
import sys

import requests

TOKEN = os.environ.get("TELEGRAM_BOT_TOKEN", "")
CHAT_ID = os.environ.get("TELEGRAM_CHAT_ID", "")


def main() -> int:
    if len(sys.argv) < 2:
        print("[-] Usage: custom-telegram <alert_file>")
        return 2
    if not TOKEN or not CHAT_ID:
        print("[-] TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID are not set")
        return 2

    with open(sys.argv[1], encoding="utf-8") as f:
        alert_json = json.load(f)

    # Extraction of alert fields
    rule_id = alert_json.get("rule", {}).get("id", "N/A")
    rule_desc = html.escape(str(alert_json.get("rule", {}).get("description", "N/A")))
    rule_level = alert_json.get("rule", {}).get("level", "N/A")
    agent_name = html.escape(str(alert_json.get("agent", {}).get("name", "N/A")))
    agent_ip = alert_json.get("agent", {}).get("ip", "N/A")

    # Attacker IP and command line
    eventdata = alert_json.get("data", {}).get("win", {}).get("eventdata", {})
    src_ip = eventdata.get("ipAddress", "N/A")
    if src_ip == "N/A":
        src_ip = alert_json.get("data", {}).get("srcip", "N/A")
    cmd_line = eventdata.get("commandLine", "N/A")

    # Message format
    message = (
        "\U0001F6A8 <b>WAZUH SOC ALERT</b> \U0001F6A8\n\n"
        f"<b>Rule ID:</b> {rule_id} (Level {rule_level})\n"
        f"<b>Description:</b> {rule_desc}\n"
        f"<b>Target Agent:</b> {agent_name} ({agent_ip})\n"
        f"<b>Source IP:</b> <code>{html.escape(str(src_ip))}</code>\n"
    )
    if cmd_line != "N/A":
        clean_cmd = html.escape(str(cmd_line)[:150])
        message += f"<b>Command:</b> <code>{clean_cmd}</code>\n"

    url = f"https://api.telegram.org/bot{TOKEN}/sendMessage"
    payload = {"chat_id": CHAT_ID, "text": message, "parse_mode": "HTML"}

    try:
        response = requests.post(url, json=payload, timeout=10)
        print(f"[*] HTTP Status: {response.status_code}")
        return 0 if response.ok else 1
    except requests.RequestException as e:
        print(f"[-] Request failed: {e}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
"""

