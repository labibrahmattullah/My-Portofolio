SECRET_PATTERNS = [
    ("Telegram bot token", re.compile(r"\b\d{8,10}:[A-Za-z0-9_-]{35}\b")),
    ("GitHub token", re.compile(r"\bgh[pousr]_[A-Za-z0-9]{36,}\b")),
    ("GitHub fine-grained token", re.compile(r"\bgithub_pat_[A-Za-z0-9_]{50,}\b")),
    ("Private key block", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("AWS access key", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("Hardcoded credential", re.compile(r"(?i)\b(api[_-]?key|secret|passwd|password|token)\b\s*[:=]\s*['\"][^'\"\s]{8,}['\"]")),
]
TEXT_EXT = {".md", ".xml", ".py", ".txt", ".json", ".yml", ".yaml", ".conf", ".gitignore"}


def secret_scan(root: Path) -> None:
    hits = []
    for p in root.rglob("*"):
        if ".git" in p.parts or not p.is_file():
            continue
        if p.suffix.lower() not in TEXT_EXT and p.name not in {"LICENSE", ".gitignore"}:
            continue
        text = p.read_text(encoding="utf-8", errors="ignore")
        for label, rx in SECRET_PATTERNS:
            if rx.search(text):
                hits.append((str(p.relative_to(root)), label))
    if hits:
        for f, l in hits:
            print(f"[!] Potential secret: {f} ({l})", file=sys.stderr)
        die("Secret scan failed. Publishing aborted.")
    info("Text secret scan: clean. (Screenshots are NOT scanned automatically; review them manually.)")


