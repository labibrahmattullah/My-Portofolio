def run(cmd, cwd: Path, check: bool = True, extra_env=None) -> subprocess.CompletedProcess:
    env = os.environ.copy()
    if extra_env:
        env.update(extra_env)
    res = subprocess.run(cmd, cwd=str(cwd), capture_output=True, text=True, env=env)
    if check and res.returncode != 0:
        die(f"Command failed: {' '.join(cmd)}\n{res.stderr.strip()}")
